{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mailhub-mcp",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-30",
  // global_fetch_strictly_public: Worker からの fetch を公開インターネット経由にする。無いと自分のゾーン宛ての fetch が
  // Access や WAF を通らずにオリジンへ直接届く（画像プロキシを足がかりにされないように）
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 正規の URL は 1 つ（MCP_RESOURCE と揃える）。workers.dev からは受け付けない
  "workers_dev": false,
  // 画面は静的アセット（SPA）。API と OAuth のパスだけ Worker が先に処理する
  "assets": {
    "binding": "ASSETS",
    // 無いパスは 404 を返す（SPA の代替にすると、どんなパスでもホームページが 200 で返ってしまう）
    "not_found_handling": "404-page",
    // API・OAuth のほか、説明ページとプライバシーポリシーも Worker を通す（Google の確認のアクセスを記録するため）
    "run_worker_first": [
      "/",
      "/about",
      "/privacy",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/token",
      "/register",
      "/callback",
      "/.well-known/*",
      "/svc/*",
      "/img/*",
      "/google86918974a41ea5c2.html",
    ],
  },
  "routes": [
    {
      "pattern": "mailhub.bktsk.com",
      "custom_domain": true,
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // 本番: Workers VPC Service → Tunnel → 同期デーモンと同じ Postgres（ロール mailhub_mcp）。
      // クエリキャッシュは無効（操作の完了やアーカイブ直後の一覧が古く見えないように）
      "id": "9ba9aeb0b140496fb56fedb8ede565a8",
      // ローカル開発はリポジトリ直下の docker compose の Postgres
      "localConnectionString": "postgres://mailhub:mailhub@localhost:5432/mailhub",
    },
  ],
  "kv_namespaces": [
    {
      // OAuth のクライアント登録・グラント・同意途中の状態（namespace 名: mailhub-oauth）
      "binding": "OAUTH_KV",
      "id": "f919439ddab44b48aecea8c16e3cdf2b",
    },
  ],
  "vars": {
    // この MCP サーバーの正式な URL（トークンの宛先）。ローカルは .dev.vars で上書きする
    "MCP_RESOURCE": "https://mailhub.bktsk.com/mcp",
    // /svc/mcp（常駐エージェント用）を守る Access の self-hosted アプリ（infra PR #66。Service Token「mydot-pod」だけを通す）。
    // Worker は Access の JWT をこのチームの公開鍵と aud で検証する。どちらかが空なら入口を閉じる
    "SVC_ACCESS_TEAM_DOMAIN": "sasapiyo.cloudflareaccess.com",
    "SVC_ACCESS_AUD": "4a1f61a03cf18bc2e30691a69bb7736c5abf37a4b06650234b9769a991e16f25",
  },
  // 次は wrangler secret put で入れる（ローカルは .dev.vars）。
  // ALLOWED_EMAILS: Access のポリシーに加えて Worker 側でも許可するアドレス（カンマ区切り）。空なら誰も通さない
  "secrets": {
    "required": [
      "ACCESS_CLIENT_ID",
      "ACCESS_CLIENT_SECRET",
      "ACCESS_TOKEN_URL",
      "ACCESS_AUTHORIZATION_URL",
      "ACCESS_JWKS_URL",
      "ALLOWED_EMAILS",
      // 画像プロキシの URL の署名用
      "IMAGE_PROXY_KEY",
    ],
  },
  "observability": {
    "enabled": true,
  },
}
